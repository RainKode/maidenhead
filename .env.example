# ---------------------------------------------------------------------------
# Maidenhead Spice — environment variables
# Copy this file to `.env.local` and fill in the values.
# The PUBLIC site works WITHOUT any of these (static menu + email).
# Fill these in to enable the database, admin panel and content management.
# ---------------------------------------------------------------------------

# --- Email (nodemailer) — required for booking/order/contact emails ---------
SMTP_HOST=
SMTP_PORT=465
# Set to "false" if your provider uses STARTTLS on port 587
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# The "From" address shown on outgoing email
SMTP_FROM=
# Where staff notifications (new booking/order/message) are delivered
MAIL_TO=

# --- Supabase — required for database, admin panel, blog & recipes ----------
# Project Settings -> API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key — SERVER ONLY. Never expose to the browser. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Supabase setup (once):
#   1. Create a Supabase project, paste the three values above.
#   2. Run the SQL in supabase/migrations/ (SQL Editor, in order).
#   3. Seed the menu from the existing static data:  node scripts/seed-supabase.mjs
#   4. Create your single admin user: Authentication -> Users -> Add user
#      (set email + password; "Auto Confirm User"). Use it to log in at /admin.
# ---------------------------------------------------------------------------
