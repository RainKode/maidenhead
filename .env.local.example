# ─── SMTP (Hostinger) ────────────────────────────────────────────────────────
# Find these values in hPanel → Emails → Email Accounts → Connect Devices
# (Manual / SMTP section)

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
# Set to "false" only if using port 587 with STARTTLS; leave blank or "true" for port 465
SMTP_SECURE=true

# Full email address of the mailbox (SMTP login)
SMTP_USER=info@maidenheadspice.co.uk

# The email account password (set in hPanel when you created the mailbox)
SMTP_PASS=your-mailbox-password-here

# The "From" address shown in outgoing mail — must match SMTP_USER on Hostinger
SMTP_FROM=info@maidenheadspice.co.uk

# ─── Recipient ───────────────────────────────────────────────────────────────
# Where booking + contact notifications are delivered (can be same mailbox or a separate one)
MAIL_TO=info@maidenheadspice.co.uk
